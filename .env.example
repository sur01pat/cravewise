# Mobile app environment variables
# Expo reads variables prefixed with EXPO_PUBLIC_ into the app bundle.
# Copy this file to .env and set the correct value for your environment.

# URL of the cravewise-api backend.
# Development (Android physical device): http://<your-local-ip>:3000
# Development (Android emulator):        http://10.0.2.2:3000
# Production (Cloud Run):                https://cravewise-api-362411373876.us-central1.run.app
EXPO_PUBLIC_API_URL=https://cravewise-api-362411373876.us-central1.run.app
