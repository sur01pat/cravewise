# Copy this file to gradle.properties and fill in your signing credentials.
# Never commit gradle.properties — it contains secrets.

android.useAndroidX=true
android.enableJetifier=true
newArchEnabled=true
hermesEnabled=true
expo.useLegacyPackaging=false
expo.gif.enabled=false
expo.webp.enabled=false
expo.webp.animated=false

# Release signing — fill in your values
CRAVEWISE_RELEASE_STORE_FILE=/path/to/cravewise-upload-key.jks
CRAVEWISE_RELEASE_STORE_PASSWORD=
CRAVEWISE_RELEASE_KEY_ALIAS=cravewise-upload
CRAVEWISE_RELEASE_KEY_PASSWORD=
